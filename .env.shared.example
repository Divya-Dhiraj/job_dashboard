# .env.shared.example — bundled-key distribution template.
#
# How this works
# --------------
# When you (the maintainer) want to ship the dashboard to a friend without
# making them sign up for their own Anthropic / Apify accounts, copy this
# file to `.env.shared` on YOUR machine, fill in the keys you want to share,
# and ship the .plugin/zip with `.env.shared` included.
#
# install.sh / install.ps1 will detect `.env.shared` next to the repo root
# and copy it into `.env` as the default. If `.env.shared` is absent, the
# scripts fall back to `.env.example` and prompt the user for their own keys.
#
# `.env.shared` is in `.gitignore` — it will NEVER be committed to the
# public repo. Distribute it out-of-band (encrypted DM, AirDrop, etc.).
# The Anthropic + Apify keys here pay against YOUR account, so anyone you
# hand it to is using your billing — only ship to people you trust.

# ───── Shared keys (paid against the maintainer's account) ─────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
APIFY_TOKEN=apify_api_REPLACE_ME

# ───── Optional ─────
RESEND_API_KEY=
NOTIFY_EMAIL=

# ───── Defaults that don't need changing ─────
PORT=3000
SCRAPE_INTERVAL_HOURS=1
MAX_JOBS_PER_RUN=50
MIN_MATCH_SCORE=30
