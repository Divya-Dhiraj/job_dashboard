# Job Dashboard — environment variables
# All values below are OPTIONAL fallbacks — the recommended path is to enter
# everything in the in-app Settings UI on first run. The .env values are
# only consulted when the corresponding setting is missing from the database.

# ───── Server ─────
PORT=3000
SCRAPE_INTERVAL_HOURS=1     # editable in Settings → Pipeline
MAX_JOBS_PER_RUN=50         # how many jobs each Apify run pulls
MIN_MATCH_SCORE=30          # editable in Settings → Pipeline

# ───── Shared API keys (per-profile if you set anthropic_key_override) ─────
APIFY_TOKEN=                # required for scraping (LinkedIn + Indeed via Apify)
ANTHROPIC_API_KEY=          # required for resume parsing + CV/cover letter generation
RESEND_API_KEY=             # optional, for email digests

# ───── Email digest fallback ─────
NOTIFY_EMAIL=               # only used if active profile has no notify_email set
